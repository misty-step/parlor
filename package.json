{
  "name": "parlor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @parlor/playground dev",
    "dev:site": "pnpm --filter @parlor/site dev",
    "build:site": "pnpm --filter @parlor/site build",
    "deploy:site": "pnpm --filter @parlor/site deploy",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:convex": "node scripts/smoke-convex.mjs",
    "typecheck": "tsc -b",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "check:all": "pnpm check && pnpm build && pnpm test:e2e && pnpm smoke:convex"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.0.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
