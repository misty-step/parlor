import {
  beginMatch,
  completeMatch,
  requireActiveMatch,
  resolvePlayer,
  sweepAbandonedMatches,
} from "@parlor/convex";
import { HARD_DEADLINE_MS } from "@parlor/core";
import { ConvexError, v } from "convex/values";
import { internal } from "./_generated/api";
import { internalMutation, mutation, query } from "./_generated/server";

// An intentionally small consumer proves that Parlor composes with game-owned
// tables and generated contexts, rather than requiring casts or a second service.
export const start = mutation({
  args: { roomId: v.id("rooms"), guestToken: v.string() },
  handler: async (ctx, args) => {
    const actor = await resolvePlayer(ctx, args.guestToken);
    const match = await beginMatch(ctx, { roomId: args.roomId, actor });
    await ctx.db.insert("gameScores", { matchId: match.id, points: 0 });
    return match.id;
  },
});

export const finish = mutation({
  args: { matchId: v.id("matches"), guestToken: v.string() },
  handler: async (ctx, args) => {
    const actor = await resolvePlayer(ctx, args.guestToken);
    await requireActiveMatch(ctx, args.matchId);
    const score = await ctx.db
      .query("gameScores")
      .withIndex("by_match", (q) => q.eq("matchId", args.matchId))
      .unique();
    if (!score) throw new ConvexError({ code: "GAME_NOT_FOUND" });
    await completeMatch(ctx, { matchId: args.matchId, actor });
    await ctx.db.patch(score._id, { points: score.points + 1 });
    return null;
  },
});

export const score = query({
  args: { matchId: v.id("matches"), guestToken: v.string() },
  handler: async (ctx, args) => {
    const actor = await resolvePlayer(ctx, args.guestToken);
    const participant = await ctx.db
      .query("matchParticipants")
      .withIndex("by_match_player", (q) => q.eq("matchId", args.matchId).eq("playerId", actor.playerId))
      .unique();
    if (!participant) throw new ConvexError({ code: "MATCH_PARTICIPANT_REQUIRED" });
    const score = await ctx.db
      .query("gameScores")
      .withIndex("by_match", (q) => q.eq("matchId", args.matchId))
      .unique();
    if (!score) throw new ConvexError({ code: "GAME_NOT_FOUND" });
    return score.points;
  },
});

export const sweep = internalMutation({
  args: { cursor: v.optional(v.string()) },
  returns: v.null(),
  handler: async (ctx, args) => {
    const result = await sweepAbandonedMatches(ctx, { ...args, limit: 1 });
    if (result.continueCursor !== null) {
      await ctx.scheduler.runAfter(0, internal.game.sweep, { cursor: result.continueCursor });
    }
    return null;
  },
});

// Only the isolated smoke runner can call this internal fixture. Gate evaluation
// happens in the same transaction as expiry, before any scheduled sweep can run.
export const expire = internalMutation({
  args: { matchId: v.id("matches") },
  handler: async (ctx, args) => {
    await ctx.db.patch(args.matchId, { startedAt: Date.now() - HARD_DEADLINE_MS - 1 });
    try {
      await requireActiveMatch(ctx, args.matchId);
      return { accepted: true };
    } catch (error) {
      if (!(error instanceof ConvexError) || error.data?.code !== "MATCH_NOT_ACTIVE") throw error;
      return { accepted: false };
    }
  },
});
