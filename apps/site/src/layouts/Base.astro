---
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource-variable/manrope/wght.css";
import { ArrowUpRight, Copy, Menu } from "@lucide/astro";
import "../styles/global.css";
import Brand from "../components/Brand.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Search from "../components/Search.astro";
import project from "../../../../package.json";

interface Props {
  title?: string;
  description?: string;
  isDocs?: boolean;
  noindex?: boolean;
}
const {
  title = "Parlor — You bring the game. We make room.",
  description = "Open-source multiplayer building blocks for games played together. Guest identity, rooms, presence, and matches for Convex and React.",
  isDocs = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3047a5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" title="Documentation for agents" href="/llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parlor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Parlor. You bring the game. We make room." />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class:list={[{ "docs-page": isDocs }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand-link" href="/" aria-label="Parlor home"><Brand /></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/docs/getting-started/" aria-current={isDocs ? "true" : undefined}>Documentation</a>
          <ExternalLink href="https://github.com/misty-step/parlor">GitHub</ExternalLink>
        </nav>
        <div class="header-actions">
          <Search />
          <a class="button button-small header-cta" href="/docs/first-game/">Get started</a>
          <details class="mobile-menu">
            <summary>Menu <Menu size={18} stroke-width={1.75} aria-hidden="true" /></summary>
            <nav aria-label="Mobile navigation">
              <a href="/docs/getting-started/">Documentation</a>
              <a href="/docs/first-game/">First Tap</a>
              <a href="/docs/agents/">For agents</a>
              <a href="/design/">Design kit</a>
              <ExternalLink href="https://github.com/misty-step/parlor">GitHub</ExternalLink>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand-link" href="/" aria-label="Parlor home"><Brand /></a>
          <p>For games that bring<br />people together.</p>
          <a class="release-link" href="/docs/installation/">
            <span>v{project.version}</span>
            <span class="badge">Source release</span>
          </a>
        </div>
        <nav aria-label="Developer resources">
          <strong>Make a game</strong>
          <a href="/docs/first-game/">Run the example</a>
          <a href="/docs/installation/">Install Parlor</a>
          <a href="/docs/api/">API reference</a>
          <a href="/docs/agents/">Agent skill</a>
        </nav>
        <nav aria-label="Open source project">
          <strong>Make it better</strong>
          <ExternalLink href="https://github.com/misty-step/parlor">Source code</ExternalLink>
          <ExternalLink href="https://github.com/misty-step/parlor/issues">Issues & ideas</ExternalLink>
          <a href="/design/">Design kit</a>
          <a href="/license.txt">MIT license</a>
        </nav>
        <div class="footer-credit">
          <strong>A <a href="https://mistystep.io" target="_blank" rel="noopener noreferrer" class="plain-ext-link">Misty Step</a> project</strong>
          <p>Tools for the things<br />we want to exist.</p>
          <ExternalLink href="https://mistystep.io">Meet Misty Step</ExternalLink>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} <a href="https://mistystep.io" target="_blank" rel="noopener noreferrer" class="plain-ext-link">Misty Step</a></span>
        <a href="/llms.txt">Documentation for agents</a>
        <ExternalLink href="https://poppycock.mistystep.io">Prefer to play? Try Poppycock.</ExternalLink>
      </div>
    </footer>
    <div class="sr-only" role="status" data-copy-status></div>
    <template id="copy-icon"><Copy size={15} stroke-width={1.75} aria-hidden="true" /></template>
    <template id="external-link-icon"><ArrowUpRight size={14} stroke-width={1.75} class="external-link__icon" aria-hidden="true" /></template>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
