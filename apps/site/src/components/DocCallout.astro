---
import { ArrowRight } from "@lucide/astro";
import ExternalLink from "./ExternalLink.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  href: string;
  action: string;
  class?: string;
  external?: boolean;
}

const {
  id,
  title,
  description,
  href,
  action,
  class: className,
  external = false,
} = Astro.props;
---
<section class:list={["doc-callout", className]} aria-labelledby={id}>
  <div class="doc-callout-icon"><slot name="icon" /></div>
  <div class="doc-callout-copy">
    <h2 id={id}>{title}</h2>
    <p>{description}</p>
  </div>
  {external ? (
    <ExternalLink class="doc-callout-action" href={href}>{action}</ExternalLink>
  ) : (
    <a class="doc-callout-action" href={href}>
      {action}
      <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
    </a>
  )}
</section>
