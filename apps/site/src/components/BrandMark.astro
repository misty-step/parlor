---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 40"
  width={size}
  height={size}
  class:list={["brand-mark", className]}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d="M6 4h14a13 13 0 0 1 0 26h-2v-7h2a6 6 0 0 0 0-12h-7v25l-7-4Z" />
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
  }
</style>
