<figure class="room-sketch" data-room-sketch data-phase="lobby" aria-labelledby="sketch-caption">
  <div class="sketch-art">
    <span class="sketch-note">Good company. Great games.</span>
    <div class="table-ring" aria-hidden="true"></div>
    <div class="game-table">
      <div class="table-content">
        <span class="room-label" data-room-label>One room. Everyone in.</span>
        <div class="room-tiles" aria-label="Example room code PLAY"><span>P</span><span>L</span><span>A</span><span>Y</span></div>
        <span class="table-status" data-room-status>4 friends, no accounts</span>
      </div>
    </div>
    <div class="player player-one"><span class="player-piece piece-yellow"><i></i></span><span class="player-name">Alex <small>host</small></span></div>
    <div class="player player-two"><span class="player-piece piece-pink"><i></i></span><span class="player-name">Jules</span></div>
    <div class="player player-three"><span class="player-piece piece-mint"><i></i></span><span class="player-name">Sam</span></div>
    <div class="player player-four"><span class="player-piece piece-lilac"><i></i></span><span class="player-name">You</span></div>
    <span class="late-player" data-late-player hidden><span>+1</span><span data-late-copy>Jo is watching</span></span>
    <div class="room-ticket"><span class="ticket-dot"></span><span data-ticket>Room ready</span><svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg></div>
  </div>
  <div class="sketch-controls" role="group" aria-label="Explore the room lifecycle">
    <button type="button" data-phase-button="lobby" aria-pressed="true">The lobby</button>
    <button type="button" data-phase-button="match" aria-pressed="false">Game on</button>
    <button type="button" data-phase-button="rematch" aria-pressed="false">One more?</button>
  </div>
  <figcaption id="sketch-caption"><span data-sketch-description aria-live="polite">Share a code. Friends join from their phones.</span><small>An interactive illustration, not a live room.</small></figcaption>
</figure>
