---
import { DoorOpen, LockKeyhole, RotateCcw, Dices, UsersRound, UserPlus } from "@lucide/astro";
import BrandMark from "./BrandMark.astro";
---
<figure class="room-art" data-room-sketch data-phase="lobby" aria-labelledby="room-art-caption">
  <div class="room-art-stage">
    <div class="room-art-back room-art-back--people" aria-hidden="true">
      <UsersRound size={48} stroke-width={1.4} />
      <span>Good company.</span>
      <div class="card-line"></div>
      <div class="card-line card-line--short"></div>
    </div>
    <div class="room-art-back room-art-back--game" aria-hidden="true">
      <Dices size={50} stroke-width={1.4} />
      <span>Your game.</span>
      <div class="card-line"></div>
      <div class="card-line card-line--short"></div>
    </div>
    <div class="room-invite">
      <div class="room-invite-header"><BrandMark size={25} /><span>Room invitation</span></div>
      <h2 data-room-label>Come on in.</h2>
      <div class="invite-code" aria-label="Room code PLAY"><span>P</span><span>L</span><span>A</span><span>Y</span></div>
      <p data-room-status>Four friends. One room.</p>
      <div class="invite-guests" aria-label="Example players: Alex, Jules, Sam, and you">
        <span title="Alex">A</span>
        <span title="Jules">J</span>
        <span title="Sam">S</span>
        <span title="You">Y</span>
        <span class="invite-new-guest" data-new-guest hidden title="Jo">J</span>
      </div>
      <div class="invite-footer" aria-live="polite">
        <span data-phase-icon="lobby"><DoorOpen size={17} stroke-width={1.75} aria-hidden="true" /></span>
        <span data-phase-icon="match" hidden><LockKeyhole size={17} stroke-width={1.75} aria-hidden="true" /></span>
        <span data-phase-icon="rematch" hidden><RotateCcw size={17} stroke-width={1.75} aria-hidden="true" /></span>
        <span data-ticket>Everyone starts here</span>
      </div>
    </div>
    <div class="late-player" data-late-player hidden>
      <span class="late-badge"><UserPlus size={17} stroke-width={1.75} aria-hidden="true" /></span>
      <span data-late-copy>Jo can watch this match</span>
    </div>
  </div>
  <div class="sketch-controls" role="group" aria-label="Explore a room’s lifecycle">
    <button type="button" data-phase-button="lobby" aria-pressed="true"><UsersRound size={16} stroke-width={1.75} aria-hidden="true" />Gather</button>
    <button type="button" data-phase-button="match" aria-pressed="false"><Dices size={16} stroke-width={1.75} aria-hidden="true" />Play</button>
    <button type="button" data-phase-button="rematch" aria-pressed="false"><RotateCcw size={16} stroke-width={1.75} aria-hidden="true" />Again</button>
  </div>
  <figcaption id="room-art-caption" class="sr-only">Explore how a room gathers guests, starts a match with a fixed lineup, and welcomes a new player for the next match.</figcaption>
</figure>
