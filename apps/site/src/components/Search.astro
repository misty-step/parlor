---
import { ArrowDown, ArrowUp, Search as SearchIcon, X } from "@lucide/astro";
---
<button class="search-trigger" type="button" data-search-open hidden aria-label="Search documentation" aria-haspopup="dialog" aria-controls="doc-search">
  <SearchIcon size={18} stroke-width={1.75} aria-hidden="true" /><span>Search</span><kbd>/</kbd>
</button>
<dialog id="doc-search" aria-labelledby="search-title">
  <div class="search-panel">
    <div class="search-heading"><h2 id="search-title">Search the handbook</h2><button class="icon-button" type="button" data-search-close aria-label="Close search"><X size={20} stroke-width={1.75} aria-hidden="true" /></button></div>
    <label class="sr-only" for="search-query">Search documentation</label>
    <input id="search-query" type="search" placeholder="Rooms, guest tokens, your first game…" autocomplete="off" spellcheck="false" aria-controls="search-results" aria-describedby="search-status" />
    <p id="search-status" class="search-status" role="status">Type to search the guides and API reference.</p>
    <ul id="search-results" class="search-results" aria-label="Search results"></ul>
    <div class="search-footer"><a href="/docs/getting-started/">Browse the handbook</a><span><kbd><ArrowUp size={12} stroke-width={1.75} aria-label="Up" /></kbd><kbd><ArrowDown size={12} stroke-width={1.75} aria-label="Down" /></kbd> to explore <kbd>esc</kbd> to close</span></div>
  </div>
</dialog>
